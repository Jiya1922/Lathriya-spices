# Django Core Settings
SECRET_KEY=django-insecure-lathriya-spices-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Supabase Database Connection (Single DATABASE_URL string is supported and recommended!)
# Example for Supabase Pooler (Transaction mode port 6543 or Session mode port 5432):
# DATABASE_URL=postgresql://postgres.your_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

DATABASE_URL=

# (Optional: Individual parameters fallback)
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_supabase_db_password
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543

# Supabase Storage Credentials (S3 Compatible API for Private Buckets)
# Retrieve your S3 Access Keys from Supabase Dashboard -> Storage Settings -> S3 Access Keys
SUPABASE_STORAGE_BUCKET=spices-posters
SUPABASE_STORAGE_S3_KEY_ID=your_supabase_s3_access_key_id
SUPABASE_STORAGE_S3_SECRET_KEY=your_supabase_s3_secret_access_key
SUPABASE_STORAGE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=ap-southeast-1

# Google OAuth Credentials (for django-allauth)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

