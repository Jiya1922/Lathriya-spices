# ==============================================================================
# LATHRIYA SPICES - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and fill in real production values.
# DO NOT COMMIT YOUR REAL .env FILE TO GIT!
# ==============================================================================

# Django Core & Security
SECRET_KEY=django-insecure-change-this-in-production-key-9074913271
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,lathriyaspices.com,www.lathriyaspices.com,.onrender.com,.railway.app,.herokuapp.com,.vercel.app

# Domain & Site URLs
SITE_DOMAIN=lathriyaspices.com
SITE_URL=https://lathriyaspices.com

# Google OAuth Authentication (Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Database Configuration (Supabase PostgreSQL / Remote Database)
DATABASE_URL=postgresql://postgres.xxx:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase Storage S3 Bucket Configuration (Receipt PDFs & Media)
SUPABASE_STORAGE_S3_KEY_ID=YOUR_SUPABASE_S3_ACCESS_KEY
SUPABASE_STORAGE_S3_SECRET_KEY=YOUR_SUPABASE_S3_SECRET_KEY
SUPABASE_STORAGE_S3_ENDPOINT=https://xxx.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=ap-southeast-1
SUPABASE_RECEIPTS_BUCKET=payment-receipts
SUPABASE_STORAGE_BUCKET=spices-posters

# Razorpay Payment Gateway Keys & Webhook Secret
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE
